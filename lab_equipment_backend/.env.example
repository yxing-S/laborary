# 复制为 .env 后按部署环境修改
# ============ 数据库（MySQL 8）============
# 方式一：分项配置（推荐，密码含特殊字符时无需 URL 编码）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_equipment
DB_USER=root
DB_PASSWORD=CHANGE_ME
# 方式二：整段 URL（设置后优先级高于上面的分项）
# DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/lab_equipment

# ============ Django ============
# 生产环境务必替换为随机长字符串
SECRET_KEY=please-change-this-to-a-random-secret-key
DEBUG=False
# 前后端同机部署时 Nginx 回源 Host 为 127.0.0.1，通常填 127.0.0.1,localhost 即可
ALLOWED_HOSTS=127.0.0.1,localhost,62.234.128.72

# ============ JWT（G6）============
JWT_ACCESS_MINUTES=720
